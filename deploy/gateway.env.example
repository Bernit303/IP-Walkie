# /etc/lan-walkie-gateway.env  -- settings for lan-walkie-gateway.service
# Install with:  sudo install -m 600 -o root -g root gateway.env.example /etc/lan-walkie-gateway.env
# then edit it. Keep it mode 600: it can hold the priority token.

# The signaling server.
WALKIE_URL=wss://your-server:8443

# Name shown to everyone else on the channel.
WALKIE_NAME=Radio

# The AIOC's sound card (find it with: arecord -l).
WALKIE_ALSA=plughw:CARD=AllInOneCable,DEV=0

# How to trust the server's certificate. Pick ONE:
#  - a self-signed certificate: pin its fingerprint, e.g.
#      WALKIE_TLS_ARGS=--pin-sha256 AB:CD:...   (openssl x509 -in cert.pem -noout -fingerprint -sha256)
#  - a real certificate (for example Tailscale Serve): leave it empty.
WALKIE_TLS_ARGS=

# Optional extra flags, e.g. --vox-threshold-db -38 --vox-hang-ms 2000
WALKIE_EXTRA_ARGS=

# Software squelch: the gate that decides when what the radio hears is sent to the LAN.
#   on  (default): the gate as it has always been.
#   off: almost no software gate; the radio's own squelch does the filtering, and a
#        300 ms pre-roll keeps the start of a transmission. See cli/README.md.
#LAN_WALKIE_SQUELCH=on

# Priority: lets the radio interrupt whoever is talking. Must equal the server's
# PRIORITY_TOKEN. It is only ever sent over a verified connection.
#LAN_WALKIE_TOKEN=
